# Core editor & terminal
brew "neovim"
brew "tmux"

# Git tooling
brew "git"
brew "lazygit"
brew "gh"

# CLI utilities used by nvim configs / tmux popups
brew "ripgrep"   # snacks.picker grep, telescope grep
brew "fd"        # fast file finder for pickers
brew "fzf"       # tmux window switcher popup
brew "jq"        # JqFormat autocmd in nvim/lua/config/autocmds.lua
brew "bat"       # snacks/lazygit preview rendering

# Node runtime — copilot.lua pins to node@22
brew "node@22"
